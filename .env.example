# anthropic api key used by the agent
ANTHROPIC_API_KEY=

# store subdomain, without .myshopify.com
SHOPIFY_STORE=
# dev dashboard app credentials (client credentials grant)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-10

# dev stores are password protected; used to render the storefront for checks
STOREFRONT_PASSWORD=

# optional: theme access password for non-interactive theme pushes (otherwise run `npx shopify auth login` once)
# SHOPIFY_CLI_THEME_TOKEN=

# optional overrides
# MODEL=claude-opus-5-5
# MAX_TURNS=40
# MAX_BUDGET_USD=2
