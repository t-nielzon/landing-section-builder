{
  "name": "landing-section-builder",
  "version": "1.0.0",
  "description": "Claude Agent SDK script that rebuilds a product landing page as an editable Shopify section",
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "start": "tsx --env-file=.env src/run.ts",
    "reset": "tsx --env-file=.env src/reset.ts",
    "smoke": "tsx --env-file=.env src/smoke.ts",
    "typecheck": "tsc -p ."
  },
  "license": "UNLICENSED",
  "type": "module",
  "private": "true",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.308",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@shopify/cli": "^4.9.4",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
