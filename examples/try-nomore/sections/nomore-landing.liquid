{%- liquid
  assign sel_qty = 1
  for block in section.blocks
    if block.type == 'bundle' and block.settings.selected
      assign sel_qty = block.settings.quantity
    endif
  endfor
  assign body_font_b = section.settings.body_font | font_modify: 'weight', 'bold'
  assign body_font_m = section.settings.body_font | font_modify: 'weight', '500'
  assign body_font_k = section.settings.body_font | font_modify: 'weight', '900'
-%}
{% style %}
  {{ section.settings.body_font | font_face: font_display: 'swap' }}
  {{ body_font_b | font_face: font_display: 'swap' }}
  {{ body_font_m | font_face: font_display: 'swap' }}
  {{ body_font_k | font_face: font_display: 'swap' }}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  #shopify-section-{{ section.id }} { --accent: {{ section.settings.accent }}; --text: {{ section.settings.text_color }}; --bg: {{ section.settings.bg }}; --g1: {{ section.settings.grad_start }}; --g2: {{ section.settings.grad_end }}; background: var(--bg); }
  #shopify-section-{{ section.id }} .nml { max-width: 500px; margin: 0 auto; font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }}; color: var(--text); letter-spacing: .6px; overflow: hidden; }
  #shopify-section-{{ section.id }} .nml *, #shopify-section-{{ section.id }} .nml *::before { box-sizing: border-box; }
  #shopify-section-{{ section.id }} .nml img { display: block; max-width: 100%; height: auto; }
  #shopify-section-{{ section.id }} .nml-slider { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; background: #fff; }
  #shopify-section-{{ section.id }} .nml-slider::-webkit-scrollbar { display: none; }
  #shopify-section-{{ section.id }} .nml-slide { flex: 0 0 100%; scroll-snap-align: start; aspect-ratio: 1; }
  #shopify-section-{{ section.id }} .nml-slide img { width: 100%; height: 100%; object-fit: contain; }
  #shopify-section-{{ section.id }} .nml-dots { display: flex; justify-content: center; gap: 6px; padding: 14px 0 0; }
  #shopify-section-{{ section.id }} .nml-dot { width: 9px; height: 9px; border-radius: 50%; border: 1px solid #9a9a9a; background: transparent; padding: 0; cursor: pointer; transition: transform .2s; }
  #shopify-section-{{ section.id }} .nml-dot.is-active { background: #000; border-color: #000; }
  #shopify-section-{{ section.id }} .nml-info { padding: 36px 15px 20px; }
  #shopify-section-{{ section.id }} .nml-rating { display: flex; align-items: center; gap: 12px; font-size: 15px; line-height: 21px; color: rgba(0,0,0,.75); }
  #shopify-section-{{ section.id }} .nml-stars { position: relative; display: inline-flex; line-height: 0; }
  #shopify-section-{{ section.id }} .nml-stars__fill { position: absolute; inset: 0; overflow: hidden; display: flex; white-space: nowrap; }
  #shopify-section-{{ section.id }} .nml-stars svg { flex: 0 0 auto; }
  #shopify-section-{{ section.id }} .nml-title { font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }}; font-weight: 700; font-size: 30px; line-height: 39px; margin: 14px 0 5px; color: #000; }
  #shopify-section-{{ section.id }} .nml-tagline { font-weight: 700; font-size: 14px; line-height: 22.4px; margin: 0; letter-spacing: 0; color: #000; }
  #shopify-section-{{ section.id }} .nml-cure { text-align: center; font-weight: 700; font-size: 17px; line-height: 30.6px; margin: 8px 0 4px; color: #000; }
  #shopify-section-{{ section.id }} .nml-divider { display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 14px; line-height: 19.6px; margin: 20px 0 15px; color: #000; white-space: nowrap; }
  #shopify-section-{{ section.id }} .nml-divider::before, #shopify-section-{{ section.id }} .nml-divider::after { content: ""; flex: 1; height: 2px; background: rgba(0,0,0,.2); }
  #shopify-section-{{ section.id }} .nml-bundles { display: grid; gap: 10px; }
  #shopify-section-{{ section.id }} .nml-bundle { position: relative; display: flex; align-items: center; gap: 18px; padding: 14px 20px; min-height: 75px; border-radius: 8px; background: rgba(255,255,255,.573); box-shadow: inset 0 0 0 1px rgba(0,0,0,.3); cursor: pointer; text-align: left; border: 0; width: 100%; font: inherit; color: inherit; }
  #shopify-section-{{ section.id }} .nml-bundle--badge { min-height: 89px; margin-top: 8px; }
  #shopify-section-{{ section.id }} .nml-bundle.is-selected { background: {{ section.settings.selected_bg }}; box-shadow: inset 0 0 0 2px #000; }
  #shopify-section-{{ section.id }} .nml-radio { flex: 0 0 20px; height: 20px; border-radius: 50%; background: #fff; border: 3px solid #fff; box-shadow: 0 0 0 2px rgba(0,0,0,.3); }
  #shopify-section-{{ section.id }} .is-selected .nml-radio { background: #000; box-shadow: 0 0 0 2px #000; }
  #shopify-section-{{ section.id }} .nml-bundle__name { font-weight: 700; font-size: 20px; line-height: 28px; letter-spacing: 0; color: #000; }
  #shopify-section-{{ section.id }} .nml-save { display: inline-block; margin-left: 8px; padding: 4px 8px; border-radius: 8px; background: {{ section.settings.save_bg }}; color: #fff; font-size: 12px; line-height: 16.8px; font-weight: 700; font-style: italic; letter-spacing: 0; vertical-align: middle; }
  #shopify-section-{{ section.id }} .nml-bundle__left { flex: 1; display: flex; align-items: center; flex-wrap: wrap; }
  #shopify-section-{{ section.id }} .nml-bundle__prices { text-align: right; }
  #shopify-section-{{ section.id }} .nml-price { font-weight: 700; font-size: 20px; line-height: 28px; letter-spacing: 0; color: #000; }
  #shopify-section-{{ section.id }} .nml-compare { font-size: 14px; line-height: 19.6px; color: {{ section.settings.compare_color }}; text-decoration: line-through; letter-spacing: 0; }
  #shopify-section-{{ section.id }} .nml-badge { position: absolute; top: -8px; right: 16px; padding: 6px 8px; color: #fff; font: 700 12px/12px sans-serif; border-radius: 0 0 5px 5px; }
  #shopify-section-{{ section.id }} .nml-gifts-h { text-align: center; margin: 17px 0 6px; }
  #shopify-section-{{ section.id }} .nml-gifts-h b { display: block; font-weight: 900; font-size: 20px; line-height: 24px; }
  #shopify-section-{{ section.id }} .nml-gifts-h span { font-size: 16px; line-height: 22.4px; }
  #shopify-section-{{ section.id }} .nml-gifts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; padding-top: 8px; }
  #shopify-section-{{ section.id }} .nml-gift { position: relative; min-height: 204px; border-radius: 8px; padding: 14px 10px 10px; text-align: center; background: rgba(255,255,255,.573); box-shadow: inset 0 0 0 1px rgba(0,0,0,.3); }
  #shopify-section-{{ section.id }} .nml-gift.is-unlocked { background: {{ section.settings.selected_bg }}; box-shadow: inset 0 0 0 2px #000; }
  #shopify-section-{{ section.id }} .nml-gift__tag { position: absolute; top: -8px; left: 50%; transform: translateX(-50%); background: #000; color: #fff; border-radius: 8px; padding: 8px 8px; font-size: 12px; line-height: 12px; font-weight: 450; white-space: nowrap; }
  #shopify-section-{{ section.id }} .nml-gift__tag s { margin-left: 4px; }
  #shopify-section-{{ section.id }} .nml-gift__img { width: 100%; aspect-ratio: 1; object-fit: contain; }
  #shopify-section-{{ section.id }} .nml-gift__title { display: block; margin-top: 9px; font-weight: 500; font-size: 14px; line-height: 19.6px; }
  #shopify-section-{{ section.id }} .nml-gift__lock { display: none; padding-top: 0; color: #555; font-weight: 500; font-size: 14px; line-height: 19.6px; }
  #shopify-section-{{ section.id }} .nml-gift__lock svg { display: block; margin: 0 auto 6px; width: 93px; height: 100px; }
  #shopify-section-{{ section.id }} .nml-gift:not(.is-unlocked) .nml-gift__lock { display: block; }
  #shopify-section-{{ section.id }} .nml-gift:not(.is-unlocked) .nml-gift__body { display: none; }
  #shopify-section-{{ section.id }} .is-unlocked .nml-gift__body { animation: nmlUnlock .5s ease; }
  @keyframes nmlUnlock { from { opacity: 0; transform: scale(.85); } to { opacity: 1; transform: none; } }
  #shopify-section-{{ section.id }} .nml-atc { display: block; width: 100%; margin-top: 26px; height: 47px; border: 0; border-radius: 8px; cursor: pointer; color: #fff; font: 700 21px/25.2px {{ section.settings.body_font.family }}, sans-serif; letter-spacing: 1px; background: radial-gradient(ellipse at center, {{ section.settings.btn_start }} 0%, {{ section.settings.btn_end }} 75%); box-shadow: 0 3px 0 0 {{ section.settings.btn_shadow }}, 0 5px 10px 0 rgba(0,0,0,.5); transition: filter .2s, transform .2s; }
  #shopify-section-{{ section.id }} .nml-atc:hover { filter: brightness(1.08); }
  #shopify-section-{{ section.id }} .nml-atc:active { transform: translateY(2px); }
  #shopify-section-{{ section.id }} .nml-guarantee { display: flex; align-items: center; justify-content: center; gap: 9px; margin: 18px 0 0; font-weight: 700; font-size: 14px; line-height: 25.2px; color: rgba(0,0,0,.75); }
  #shopify-section-{{ section.id }} .nml-reviews { position: relative; margin-top: 20px; padding: 10px 12px; }
  #shopify-section-{{ section.id }} .nml-rtrack { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; border-radius: 8px; }
  #shopify-section-{{ section.id }} .nml-rtrack::-webkit-scrollbar { display: none; }
  #shopify-section-{{ section.id }} .nml-review { flex: 0 0 100%; scroll-snap-align: start; display: flex; gap: 12px; align-items: center; background: #fff; border-radius: 8px; padding: 8px 8px 8px 8px; min-height: 115px; }
  #shopify-section-{{ section.id }} .nml-review__img { flex: 0 0 56px; width: 56px; height: 74px; border-radius: 8px; background: #ddd; object-fit: cover; }
  #shopify-section-{{ section.id }} .nml-review__head { display: flex; align-items: center; gap: 5px; }
  #shopify-section-{{ section.id }} .nml-review__name { font-weight: 700; font-size: 13px; line-height: 16.9px; }
  #shopify-section-{{ section.id }} .nml-review p { margin: 4px 0 0; font-size: 12px; line-height: 15.6px; }
  #shopify-section-{{ section.id }} .nml-arrow { position: absolute; top: 50%; transform: translateY(-50%); width: 24px; height: 24px; border-radius: 50%; border: 0; padding: 4px; background: #f3f3f3; box-shadow: 0 -2px 12px rgba(0,0,0,.08); cursor: pointer; line-height: 0; }
  #shopify-section-{{ section.id }} .nml-arrow--prev { left: 4px; }
  #shopify-section-{{ section.id }} .nml-arrow--next { right: 4px; }
  #shopify-section-{{ section.id }} .nml-iwt { padding-bottom: 40px; }
  #shopify-section-{{ section.id }} .nml-iwt__img { width: 100%; aspect-ratio: 1; object-fit: cover; }
  #shopify-section-{{ section.id }} .nml-iwt__text { padding: 40px 32px 0; }
  #shopify-section-{{ section.id }} .nml-iwt h2 { margin: 0 0 20px; font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }}; font-weight: 700; font-size: 27.5px; line-height: 35.75px; letter-spacing: .6px; padding-right: 12px; background: linear-gradient(127deg, var(--g1) 21%, var(--g2) 81%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  #shopify-section-{{ section.id }} .nml-iwt__body { font-size: 15px; line-height: 27px; color: #000; }
  #shopify-section-{{ section.id }} .nml-iwt__body p { margin: 0 0 10px; }
  #shopify-section-{{ section.id }} .nml-iwt__body strong { font-weight: 700; }
  #shopify-section-{{ section.id }} .nml-pct { background: {{ section.settings.pct_bg }}; padding: 60px 16px; text-align: center; margin: 0 calc(50% - 50vw); }
  #shopify-section-{{ section.id }} .nml-pct__num { display: flex; justify-content: center; gap: 13px; font-weight: 900; font-size: 60px; line-height: 60px; letter-spacing: -1.2px; }
  #shopify-section-{{ section.id }} .nml-pct__num span { background: linear-gradient(127deg, var(--g1) 21%, var(--g2) 81%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  #shopify-section-{{ section.id }} .nml-pct p { margin: 24px 0 0; font-weight: 700; font-size: 18px; line-height: 32.4px; color: #000; }
  #shopify-section-{{ section.id }} .nml-reveal { opacity: 0; transform: translateY(24px); transition: opacity .7s ease, transform .7s ease; }
  #shopify-section-{{ section.id }} .nml-reveal.is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .nml-reveal { opacity: 1; transform: none; transition: none; }
    #shopify-section-{{ section.id }} .nml-slider, #shopify-section-{{ section.id }} .nml-rtrack { scroll-behavior: auto; }
    #shopify-section-{{ section.id }} .is-unlocked .nml-gift__body { animation: none; }
  }
{% endstyle %}

{%- capture star -%}<svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2l2.9 6.9 7.1.6-5.4 4.7 1.6 7.3L12 17.8 5.8 21.5l1.6-7.3L2 9.5l7.1-.6z"/></svg>{%- endcapture -%}

<div class="nml" data-nml>
  <div class="nml-hero">
    <div class="nml-slider" data-slider>
      {%- assign si = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'slide' -%}
          <div class="nml-slide" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {%- if si == 0 -%}
                {{ block.settings.image | image_url: width: 1100 | image_tag: widths: '390,600,780,1100', sizes: '(min-width: 520px) 500px, 100vw', alt: block.settings.alt, loading: 'eager', fetchpriority: 'high' }}
              {%- else -%}
                {{ block.settings.image | image_url: width: 1100 | image_tag: widths: '390,600,780,1100', sizes: '(min-width: 520px) 500px, 100vw', alt: block.settings.alt, loading: 'lazy' }}
              {%- endif -%}
            {%- endif -%}
          </div>
          {%- assign si = si | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="nml-dots" data-dots>
      {%- for i in (1..si) -%}<button type="button" class="nml-dot{% if forloop.first %} is-active{% endif %}" aria-label="{{ section.settings.dot_label }} {{ i }}"></button>{%- endfor -%}
    </div>
  </div>

  <div class="nml-info nml-reveal">
    <div class="nml-rating">
      {%- assign pct = section.settings.rating | times: 20 -%}
      <span class="nml-stars" style="color:#d0d0d0">
        {%- for i in (1..5) -%}{{ star }}{%- endfor -%}
        <span class="nml-stars__fill" style="width:{{ pct }}%;color:{{ section.settings.star_color }}">{%- for i in (1..5) -%}{{ star }}{%- endfor -%}</span>
      </span>
      <span>{{ section.settings.rating_text }}</span>
    </div>
    <h1 class="nml-title">{{ section.settings.title }}</h1>
    <p class="nml-tagline">{{ section.settings.tagline }}</p>
    {%- if section.settings.cure_heading != blank -%}<div class="nml-cure">{{ section.settings.cure_heading }}</div>{%- endif -%}
    {%- if section.settings.cure_image != blank -%}
      {{ section.settings.cure_image | image_url: width: 1000 | image_tag: widths: '360,720,1000', sizes: '(min-width: 520px) 470px, calc(100vw - 30px)', alt: section.settings.cure_alt, loading: 'lazy' }}
    {%- endif -%}

    <div class="nml-divider">{{ section.settings.bundle_heading }}</div>
    {%- form 'product', product, data-nml-form: '' -%}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <input type="hidden" name="quantity" value="{{ sel_qty }}" data-qty>
      <div class="nml-bundles" role="radiogroup">
        {%- for block in section.blocks -%}
          {%- if block.type == 'bundle' -%}
            <button type="button" role="radio" aria-checked="{{ block.settings.selected }}" class="nml-bundle{% if block.settings.selected %} is-selected{% endif %}{% if block.settings.badge != blank %} nml-bundle--badge{% endif %}" data-bundle data-qty-val="{{ block.settings.quantity }}" {{ block.shopify_attributes }}>
              {%- if block.settings.badge != blank -%}<span class="nml-badge" style="background:{{ block.settings.badge_color }}">{{ block.settings.badge }}</span>{%- endif -%}
              <span class="nml-radio"></span>
              <span class="nml-bundle__left"><span class="nml-bundle__name">{{ block.settings.title }}</span>{%- if block.settings.save != blank -%}<span class="nml-save">{{ block.settings.save }}</span>{%- endif -%}</span>
              <span class="nml-bundle__prices"><span class="nml-price" style="display:block">{{ block.settings.price }}</span>{%- if block.settings.compare != blank -%}<span class="nml-compare" style="display:block">{{ block.settings.compare }}</span>{%- endif -%}</span>
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="nml-gifts-h"><b>{{ section.settings.gifts_heading }}</b><span>{{ section.settings.gifts_sub }}</span></div>
      <div class="nml-gifts">
        {%- for block in section.blocks -%}
          {%- if block.type == 'gift' -%}
            <div class="nml-gift{% if sel_qty >= block.settings.unlock_qty %} is-unlocked{% endif %}" data-gift data-unlock="{{ block.settings.unlock_qty }}" {{ block.shopify_attributes }}>
              <span class="nml-gift__tag">{{ block.settings.free_label }}<s>{{ block.settings.value }}</s></span>
              <div class="nml-gift__body">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 300 | image_tag: widths: '100,200,300', sizes: '100px', alt: block.settings.label, loading: 'lazy', class: 'nml-gift__img' }}
                {%- endif -%}
                <span class="nml-gift__title">{{ block.settings.label }}</span>
              </div>
              <div class="nml-gift__lock">
                <svg viewBox="0 0 93 100" fill="none" aria-hidden="true"><rect x="27" y="44" width="39" height="34" rx="5" fill="#555"/><path d="M34 44V34a12.5 12.5 0 0 1 25 0v10" stroke="#555" stroke-width="6" fill="none"/><circle cx="46.5" cy="59" r="4" fill="#fff"/><rect x="45" y="60" width="3" height="8" fill="#fff"/></svg>
                {{ block.settings.locked_label }}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <button type="submit" name="add" class="nml-atc"{% unless product.selected_or_first_available_variant.available %} disabled{% endunless %}>{{ section.settings.atc_label }}</button>
    {%- endform -%}
    <div class="nml-guarantee">
      <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="{{ section.settings.accent }}"/><path d="M6.5 12.5l3.5 3.5 7.5-8" stroke="#fff" stroke-width="2.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span>{{ section.settings.guarantee }}</span>
    </div>

    <div class="nml-reviews">
      <div class="nml-rtrack" data-rtrack>
        {%- for block in section.blocks -%}
          {%- if block.type == 'review' -%}
            <div class="nml-review" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 168 | image_tag: widths: '56,112,168', sizes: '56px', alt: block.settings.alt, loading: 'lazy', class: 'nml-review__img' }}
              {%- endif -%}
              <div>
                <div class="nml-review__head"><span class="nml-review__name">{{ block.settings.name }}</span><span style="color:#000;display:inline-flex;line-height:0">{%- for i in (1..block.settings.rating) -%}<svg width="13" height="13" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2l2.9 6.9 7.1.6-5.4 4.7 1.6 7.3L12 17.8 5.8 21.5l1.6-7.3L2 9.5l7.1-.6z"/></svg>{%- endfor -%}</span></div>
                <p>{{ block.settings.text }}</p>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <button type="button" class="nml-arrow nml-arrow--prev" data-prev aria-label="{{ section.settings.prev_label }}"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3L5 8l5 5" stroke="#000" stroke-width="2" fill="none"/></svg></button>
      <button type="button" class="nml-arrow nml-arrow--next" data-next aria-label="{{ section.settings.next_label }}"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="#000" stroke-width="2" fill="none"/></svg></button>
    </div>
  </div>

  <div class="nml-iwt nml-reveal">
    {%- if section.settings.iwt_image != blank -%}
      {{ section.settings.iwt_image | image_url: width: 1000 | image_tag: widths: '390,600,780,1000', sizes: '(min-width: 520px) 500px, 100vw', alt: section.settings.iwt_alt, loading: 'lazy', class: 'nml-iwt__img' }}
    {%- endif -%}
    <div class="nml-iwt__text">
      <h2>{{ section.settings.iwt_heading }}</h2>
      <div class="nml-iwt__body">{{ section.settings.iwt_body }}</div>
    </div>
  </div>

  <div class="nml-pct nml-reveal">
    <div class="nml-pct__num"><span data-counter data-to="{{ section.settings.pct_value }}">{{ section.settings.pct_value }}</span><span>{{ section.settings.pct_symbol }}</span></div>
    <p>{{ section.settings.pct_text }}</p>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var slider = root.querySelector('[data-slider]'), dots = root.querySelectorAll('.nml-dot');
    dots.forEach(function (d, i) { d.addEventListener('click', function () { slider.scrollTo({ left: i * slider.clientWidth, behavior: reduce ? 'auto' : 'smooth' }); }); });
    slider.addEventListener('scroll', function () { var i = Math.round(slider.scrollLeft / slider.clientWidth); dots.forEach(function (d, j) { d.classList.toggle('is-active', i === j); }); }, { passive: true });
    var qty = root.querySelector('[data-qty]'), bundles = root.querySelectorAll('[data-bundle]'), gifts = root.querySelectorAll('[data-gift]');
    function apply(q) { gifts.forEach(function (g) { g.classList.toggle('is-unlocked', q >= parseInt(g.dataset.unlock, 10)); }); }
    bundles.forEach(function (b) { b.addEventListener('click', function () { bundles.forEach(function (o) { o.classList.remove('is-selected'); o.setAttribute('aria-checked', 'false'); }); b.classList.add('is-selected'); b.setAttribute('aria-checked', 'true'); qty.value = b.dataset.qtyVal; apply(parseInt(b.dataset.qtyVal, 10)); }); });
    var tr = root.querySelector('[data-rtrack]');
    root.querySelector('[data-prev]').addEventListener('click', function () { tr.scrollBy({ left: -tr.clientWidth, behavior: 'smooth' }); });
    root.querySelector('[data-next]').addEventListener('click', function () { tr.scrollBy({ left: tr.clientWidth, behavior: 'smooth' }); });
    var counter = root.querySelector('[data-counter]');
    function count() { var to = parseFloat(counter.dataset.to) || 0, t0 = null; function step(t) { if (!t0) t0 = t; var p = Math.min((t - t0) / 2000, 1), e = p * (2 - p); counter.textContent = Math.round(to * e); if (p < 1) requestAnimationFrame(step); } requestAnimationFrame(step); }
    var reveals = root.querySelectorAll('.nml-reveal');
    if (!('IntersectionObserver' in window) || reduce) { reveals.forEach(function (r) { r.classList.add('is-in'); }); return; }
    counter.textContent = '0';
    var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (!e.isIntersecting) return; e.target.classList.add('is-in'); if (e.target.contains(counter)) count(); io.unobserve(e.target); }); }, { threshold: 0.15 });
    reveals.forEach(function (r) { io.observe(r); });
  })();
</script>

