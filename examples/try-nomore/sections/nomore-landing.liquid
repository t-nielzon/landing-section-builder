{%- liquid
  assign sid = '#shopify-section-' | append: section.id
  assign body_font = section.settings.body_font
  assign body_bold = body_font | font_modify: 'weight', 'bold'
  assign body_black = body_font | font_modify: 'weight', '900'
  assign body_medium = body_font | font_modify: 'weight', '500'
  assign head_font = section.settings.heading_font
  assign default_qty = 1
  for block in section.blocks
    if block.type == 'bundle' and block.settings.selected
      assign default_qty = block.settings.quantity
    endif
  endfor
-%}
<style>
  {{ body_font | font_face: font_display: 'swap' }}
  {% if body_bold %}{{ body_bold | font_face: font_display: 'swap' }}{% endif %}
  {% if body_black %}{{ body_black | font_face: font_display: 'swap' }}{% endif %}
  {% if body_medium %}{{ body_medium | font_face: font_display: 'swap' }}{% endif %}
  {{ head_font | font_face: font_display: 'swap' }}

  {{ sid }} .nm{--accent:{{ section.settings.accent }};--text:{{ section.settings.text_color }};--bg:{{ section.settings.bg }};--sel-bg:{{ section.settings.selected_bg }};font-family:{{ body_font.family }},{{ body_font.fallback_families }};color:var(--text);background:var(--bg);letter-spacing:.6px;}
  {{ sid }} .nm *{box-sizing:border-box;}
  {{ sid }} .nm-col{max-width:600px;margin:0 auto;}
  {{ sid }} .nm-main{background:var(--bg);padding-bottom:15px;}
  {{ sid }} .nm-slider{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;-webkit-overflow-scrolling:touch;background:#fff;}
  {{ sid }} .nm-slider::-webkit-scrollbar{display:none;}
  {{ sid }} .nm-slide{flex:0 0 100%;scroll-snap-align:start;aspect-ratio:1/1;background:#fff;}
  {{ sid }} .nm-slide img{width:100%;height:100%;object-fit:contain;display:block;}
  {{ sid }} .nm-dots{display:flex;justify-content:center;gap:8px;padding:24px 0 0;height:56px;}
  {{ sid }} .nm-dot{width:8px;height:8px;border-radius:50%;border:1px solid #999;background:transparent;padding:0;cursor:pointer;transition:transform .2s;}
  {{ sid }} .nm-dot.is-active{background:#000;border-color:#000;}
  {{ sid }} .nm-info{padding:5px 15px 0;}
  {{ sid }} .nm-rating{display:flex;align-items:center;gap:3px;font-size:15px;line-height:21px;color:rgba(0,0,0,.75);}
  {{ sid }} .nm-stars{position:relative;display:inline-flex;}
  {{ sid }} .nm-stars svg{width:16px;height:16px;margin-right:3px;flex:none;}
  {{ sid }} .nm-stars__fill{position:absolute;inset:0 auto 0 0;overflow:hidden;display:flex;white-space:nowrap;}
  {{ sid }} .nm-stars__bg svg{fill:#dcdcdc;}
  {{ sid }} .nm-stars__fill svg{fill:var(--star);}
  {{ sid }} .nm-title{font-family:{{ head_font.family }},{{ head_font.fallback_families }};font-weight:{{ head_font.weight }};font-size:30px;line-height:39px;margin:15px 0 5px;color:#000;}
  {{ sid }} .nm-sub{font-size:14px;font-weight:700;line-height:22.4px;margin:0;color:#000;letter-spacing:0;}
  {{ sid }} .nm-cure{font-size:17px;font-weight:700;line-height:30.6px;text-align:center;margin:8px 0 4px;color:#000;}
  {{ sid }} .nm-cure-img img{width:100%;height:auto;display:block;}
  {{ sid }} .nm-divider{display:flex;align-items:center;gap:10px;font-size:14px;font-weight:700;line-height:19.6px;margin:20px 0 15px;color:#000;}
  {{ sid }} .nm-divider::before,{{ sid }} .nm-divider::after{content:"";flex:1;height:2px;background:rgba(0,0,0,.2);}
  {{ sid }} .nm-bundles{display:flex;flex-direction:column;gap:10px;}
  {{ sid }} .nm-bundle{position:relative;display:flex;align-items:center;gap:18px;padding:13px 20px;min-height:75px;border-radius:8px;background:rgba(255,255,255,.573);box-shadow:rgba(0,0,0,.3) 0 0 0 1px inset;cursor:pointer;}
  {{ sid }} .nm-bundle.has-badge{min-height:89px;padding-top:20px;}
  {{ sid }} .nm-bundle.is-selected{background:var(--sel-bg);box-shadow:#000 0 0 0 2px inset;}
  {{ sid }} .nm-bundle input{position:absolute;opacity:0;pointer-events:none;}
  {{ sid }} .nm-radio{flex:none;width:20px;height:20px;border-radius:50%;background:#fff;border:3px solid #fff;box-shadow:rgba(0,0,0,.3) 0 0 0 2px;}
  {{ sid }} .nm-bundle.is-selected .nm-radio{background:#000;box-shadow:#000 0 0 0 2px;}
  {{ sid }} .nm-bundle__main{flex:1;display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
  {{ sid }} .nm-bundle__title{font-size:20px;font-weight:700;line-height:28px;letter-spacing:0;color:#000;}
  {{ sid }} .nm-save{display:inline-block;padding:4px 8px;border-radius:8px;font-size:12px;font-weight:700;font-style:italic;line-height:16.8px;letter-spacing:0;}
  {{ sid }} .nm-bundle__prices{text-align:right;}
  {{ sid }} .nm-price{font-size:20px;font-weight:700;line-height:28px;letter-spacing:0;color:#000;}
  {{ sid }} .nm-compare{font-size:14px;line-height:19.6px;color:{{ section.settings.compare_color }};text-decoration:line-through;letter-spacing:0;}
  {{ sid }} .nm-badge{position:absolute;top:-8px;right:16px;padding:6px 8px;font-family:sans-serif;font-size:12px;font-weight:700;line-height:12px;color:#fff;border-radius:0 0 5px 5px;letter-spacing:0;}
  {{ sid }} .nm-gifts-h{text-align:center;margin:17px 0 14px;}
  {{ sid }} .nm-gifts-h b{display:block;font-size:20px;font-weight:900;line-height:24px;color:#000;}
  {{ sid }} .nm-gifts-h span{display:block;font-size:16px;line-height:22.4px;color:#000;margin-top:2px;}
  {{ sid }} .nm-gifts{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;padding-top:8px;}
  {{ sid }} .nm-gift{position:relative;min-height:204px;border-radius:8px;padding:14px 10px 10px;text-align:center;background:var(--sel-bg);box-shadow:#000 0 0 0 2px inset;}
  {{ sid }} .nm-gift.is-locked{background:rgba(255,255,255,.573);box-shadow:rgba(0,0,0,.3) 0 0 0 1px inset;}
  {{ sid }} .nm-gift__tag{position:absolute;top:-8px;left:50%;transform:translateX(-50%);display:flex;gap:6px;align-items:center;white-space:nowrap;height:28px;padding:0 8px;background:#000;color:#fff;border-radius:8px;font-size:12px;font-weight:450;line-height:12px;}
  {{ sid }} .nm-gift__tag s{text-decoration:line-through;}
  {{ sid }} .nm-gift__img{width:100%;aspect-ratio:1/1;}
  {{ sid }} .nm-gift__img img{width:100%;height:100%;object-fit:contain;display:block;}
  {{ sid }} .nm-gift__label{display:block;margin-top:9px;font-size:14px;font-weight:500;line-height:19.6px;color:#000;}
  {{ sid }} .nm-gift__lock{display:none;}
  {{ sid }} .nm-gift.is-locked .nm-gift__open{display:none;}
  {{ sid }} .nm-gift.is-locked .nm-gift__lock{display:block;}
  {{ sid }} .nm-gift__lock svg{width:100%;height:100px;display:block;}
  {{ sid }} .nm-gift__lock div{margin-top:6px;font-size:14px;font-weight:500;line-height:19.6px;color:#555;}
  {{ sid }} .nm-gift.is-unlocking .nm-gift__open{animation:nmUnlock .5s ease;}
  @keyframes nmUnlock{from{opacity:0;transform:scale(.8);}to{opacity:1;transform:none;}}
  {{ sid }} .nm-atc{display:block;width:100%;height:47px;margin-top:26px;border:0;border-radius:8px;cursor:pointer;color:#fff;font-family:inherit;font-size:21px;font-weight:700;letter-spacing:1px;background:radial-gradient(ellipse at center,{{ section.settings.btn_start }} 0%,{{ section.settings.btn_end }} 75%);box-shadow:{{ section.settings.btn_shadow }} 0 3px 0 0,rgba(0,0,0,.5) 0 5px 10px 0;transition:filter .2s,transform .2s;}
  {{ sid }} .nm-atc:hover{filter:brightness(1.08);}
  {{ sid }} .nm-atc:active{transform:translateY(2px);}
  {{ sid }} .nm-guarantee{display:flex;justify-content:center;align-items:center;gap:8px;margin:16px 0 0;font-size:14px;font-weight:700;line-height:25.2px;color:rgba(0,0,0,.75);}
  {{ sid }} .nm-guarantee svg{width:15px;height:15px;flex:none;}
  {{ sid }} .nm-reviews{position:relative;margin-top:17px;padding:10px 12px;}
  {{ sid }} .nm-rv-track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;}
  {{ sid }} .nm-rv-track::-webkit-scrollbar{display:none;}
  {{ sid }} .nm-rv{flex:0 0 100%;scroll-snap-align:start;display:flex;gap:12px;padding:8px 20px 8px 8px;background:#fff;border-radius:8px;min-height:115px;}
  {{ sid }} .nm-rv__img{flex:none;width:56px;height:74px;margin-top:12px;border-radius:8px;overflow:hidden;background:#ddd;}
  {{ sid }} .nm-rv__img img{width:100%;height:100%;object-fit:cover;display:block;}
  {{ sid }} .nm-rv__head{display:flex;align-items:center;gap:5px;}
  {{ sid }} .nm-rv__name{font-size:13px;font-weight:700;line-height:16.9px;color:#000;}
  {{ sid }} .nm-rv__stars{display:inline-flex;gap:1px;}
  {{ sid }} .nm-rv__stars svg{width:12px;height:12px;fill:#000;}
  {{ sid }} .nm-rv__text{margin:4px 0 0;font-size:12px;line-height:15.6px;color:#000;}
  {{ sid }} .nm-rv-arrow{position:absolute;top:50%;transform:translateY(-50%);width:24px;height:24px;border-radius:50%;border:0;padding:4px;background:#f3f3f3;box-shadow:rgba(0,0,0,.08) 0 -2px 12px 0;cursor:pointer;display:flex;}
  {{ sid }} .nm-rv-arrow svg{width:16px;height:16px;}
  {{ sid }} .nm-rv-prev{left:4px;}
  {{ sid }} .nm-rv-next{right:4px;}
  {{ sid }} .nm-iwt{background:{{ section.settings.iwt_bg }};padding-bottom:40px;}
  {{ sid }} .nm-iwt__img img{width:100%;height:auto;aspect-ratio:1/1;object-fit:cover;display:block;}
  {{ sid }} .nm-iwt__body{padding:40px 32px 0;}
  {{ sid }} .nm-iwt__h{font-family:{{ head_font.family }},{{ head_font.fallback_families }};font-weight:{{ head_font.weight }};font-size:27.5px;line-height:35.75px;margin:0 0 20px;background:linear-gradient(127deg,{{ section.settings.grad_start }} 21%,{{ section.settings.grad_end }} 81%);-webkit-background-clip:text;background-clip:text;color:transparent;}
  {{ sid }} .nm-iwt__txt p{margin:0 0 10px;font-size:15px;line-height:27px;color:#000;}
  {{ sid }} .nm-pct{background:{{ section.settings.pct_bg }};padding:60px 16px;text-align:center;}
  {{ sid }} .nm-pct__num{display:flex;justify-content:center;gap:13px;font-size:60px;font-weight:900;line-height:60px;letter-spacing:-1.2px;}
  {{ sid }} .nm-pct__num span{background:linear-gradient(127deg,{{ section.settings.grad_start }} 21%,{{ section.settings.grad_end }} 81%);-webkit-background-clip:text;background-clip:text;color:transparent;}
  {{ sid }} .nm-pct__txt{margin:24px 0 0;font-size:18px;font-weight:700;line-height:32.4px;color:#000;}
  {{ sid }} .nm-reveal{opacity:0;transform:translateY(30px);transition:opacity .8s ease,transform .8s ease;}
  {{ sid }} .nm-reveal.is-in{opacity:1;transform:none;}
  @media (prefers-reduced-motion: reduce){
    {{ sid }} .nm-reveal{opacity:1;transform:none;transition:none;}
    {{ sid }} .nm-slider,{{ sid }} .nm-rv-track{scroll-behavior:auto;}
    {{ sid }} .nm-gift.is-unlocking .nm-gift__open{animation:none;}
  }
</style>

<div class="nm" data-nm-root>
  <div class="nm-main">
    <div class="nm-col">
      <div class="nm-slider" data-nm-slider>
        {%- assign slide_i = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'slide' -%}
            <div class="nm-slide" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {%- if slide_i == 0 -%}
                  {{ block.settings.image | image_url: width: 1170 | image_tag: widths: '390,600,780,1170', sizes: '(min-width: 600px) 600px, 100vw', alt: block.settings.alt, loading: 'eager', fetchpriority: 'high' }}
                {%- else -%}
                  {{ block.settings.image | image_url: width: 1170 | image_tag: widths: '390,600,780,1170', sizes: '(min-width: 600px) 600px, 100vw', alt: block.settings.alt, loading: 'lazy' }}
                {%- endif -%}
              {%- endif -%}
            </div>
            {%- assign slide_i = slide_i | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="nm-dots">
        {%- for i in (1..slide_i) -%}
          <button type="button" class="nm-dot{% if forloop.first %} is-active{% endif %}" data-nm-dot="{{ forloop.index0 }}" aria-label="{{ section.settings.dot_label }} {{ i }}"></button>
        {%- endfor -%}
      </div>

      <div class="nm-info">
        {%- assign rating_pct = section.settings.rating_value | times: 20.0 -%}
        <div class="nm-rating">
          <span class="nm-stars" style="--star:{{ section.settings.star_color }}">
            <span class="nm-stars__bg" style="display:inline-flex">{% for i in (1..5) %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.1 6.6 7.2.9-5.3 5 1.4 7.1L12 18.1 5.6 21.6 7 14.5 1.7 9.5l7.2-.9z"/></svg>{% endfor %}</span>
            <span class="nm-stars__fill" style="width:{{ rating_pct }}%">{% for i in (1..5) %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.1 6.6 7.2.9-5.3 5 1.4 7.1L12 18.1 5.6 21.6 7 14.5 1.7 9.5l7.2-.9z"/></svg>{% endfor %}</span>
          </span>
          <span>{{ section.settings.rating_value }} {{ section.settings.rating_text }}</span>
        </div>
        <h1 class="nm-title">{{ section.settings.title }}</h1>
        <p class="nm-sub">{{ section.settings.subtitle }}</p>
        {%- if section.settings.cure_heading != blank -%}<div class="nm-cure">{{ section.settings.cure_heading }}</div>{%- endif -%}
        {%- if section.settings.cure_image != blank -%}
          <div class="nm-cure-img">{{ section.settings.cure_image | image_url: width: 1080 | image_tag: widths: '360,720,1080', sizes: '(min-width: 600px) 570px, calc(100vw - 30px)', alt: section.settings.cure_alt, loading: 'lazy' }}</div>
        {%- endif -%}

        {%- form 'product', product, data-nm-form: '' -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <input type="hidden" name="quantity" value="{{ default_qty }}" data-nm-qty>
          <div class="nm-divider">{{ section.settings.bundles_heading }}</div>
          <div class="nm-bundles" role="radiogroup">
            {%- for block in section.blocks -%}
              {%- if block.type == 'bundle' -%}
                <label class="nm-bundle{% if block.settings.badge != blank %} has-badge{% endif %}{% if block.settings.selected %} is-selected{% endif %}" data-nm-bundle data-qty="{{ block.settings.quantity }}" {{ block.shopify_attributes }}>
                  <input type="radio" name="nm-bundle-{{ section.id }}" value="{{ block.settings.quantity }}"{% if block.settings.selected %} checked{% endif %}>
                  {%- if block.settings.badge != blank -%}<span class="nm-badge" style="background:{{ block.settings.badge_color }}">{{ block.settings.badge }}</span>{%- endif -%}
                  <span class="nm-radio"></span>
                  <span class="nm-bundle__main">
                    <span class="nm-bundle__title">{{ block.settings.title }}</span>
                    {%- if block.settings.save_label != blank -%}<span class="nm-save" style="background:{{ section.settings.save_bg }};color:{{ section.settings.save_text }}">{{ block.settings.save_label }}</span>{%- endif -%}
                  </span>
                  <span class="nm-bundle__prices">
                    <div class="nm-price">{{ block.settings.price }}</div>
                    {%- if block.settings.compare_price != blank -%}<div class="nm-compare">{{ block.settings.compare_price }}</div>{%- endif -%}
                  </span>
                </label>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <div class="nm-gifts-h">
            <b>{{ section.settings.gifts_heading }}</b>
            <span>{{ section.settings.gifts_sub }}</span>
          </div>
          <div class="nm-gifts">
            {%- for block in section.blocks -%}
              {%- if block.type == 'gift' -%}
                {%- liquid
                  assign g_locked = false
                  if block.settings.locked and default_qty < block.settings.unlock_qty
                    assign g_locked = true
                  endif
                -%}
                <div class="nm-gift{% if g_locked %} is-locked{% endif %}" data-nm-gift data-locked="{{ block.settings.locked }}" data-unlock="{{ block.settings.unlock_qty }}" {{ block.shopify_attributes }}>
                  <span class="nm-gift__tag"><span>{{ block.settings.free_label }}</span>{% if block.settings.value != blank %}<s>{{ block.settings.value }}</s>{% endif %}</span>
                  <div class="nm-gift__open">
                    <div class="nm-gift__img">
                      {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 279 | image_tag: widths: '93,186,279', sizes: '93px', alt: block.settings.label, loading: 'lazy' }}{%- endif -%}
                    </div>
                    <span class="nm-gift__label">{{ block.settings.label }}</span>
                  </div>
                  <div class="nm-gift__lock">
                    <svg viewBox="0 0 93 100" fill="none" aria-hidden="true"><path d="M35 44V34a11.5 11.5 0 0 1 23 0v10" stroke="#5a6672" stroke-width="7" stroke-linecap="round"/><rect x="27" y="43" width="39" height="34" rx="5" fill="#5a6672"/><circle cx="46.5" cy="57" r="4.5" fill="#fff"/><rect x="44.5" y="58" width="4" height="9" rx="2" fill="#fff"/></svg>
                    <div>{{ section.settings.locked_label }}</div>
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <button type="submit" name="add" class="nm-atc">{{ section.settings.atc_label }}</button>
        {%- endform -%}

        {%- if section.settings.guarantee != blank -%}
          <p class="nm-guarantee"><svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="8" fill="{{ section.settings.accent }}"/><path d="M4.5 8.2l2.3 2.3 4.7-4.8" stroke="#fff" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg><span>{{ section.settings.guarantee }}</span></p>
        {%- endif -%}
      </div>

      <div class="nm-reviews">
        <div class="nm-rv-track" data-nm-rv>
          {%- for block in section.blocks -%}
            {%- if block.type == 'review' -%}
              <div class="nm-rv" {{ block.shopify_attributes }}>
                <div class="nm-rv__img">
                  {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 168 | image_tag: widths: '56,112,168', sizes: '56px', alt: block.settings.alt, loading: 'lazy' }}{%- endif -%}
                </div>
                <div>
                  <div class="nm-rv__head">
                    <span class="nm-rv__name">{{ block.settings.name }}</span>
                    <span class="nm-rv__stars">{% for i in (1..block.settings.rating) %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.1 6.6 7.2.9-5.3 5 1.4 7.1L12 18.1 5.6 21.6 7 14.5 1.7 9.5l7.2-.9z"/></svg>{% endfor %}</span>
                  </div>
                  <p class="nm-rv__text">{{ block.settings.text }}</p>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <button type="button" class="nm-rv-arrow nm-rv-prev" data-nm-rv-dir="-1" aria-label="{{ section.settings.prev_label }}"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3L5 8l5 5" stroke="#000" stroke-width="2" fill="none"/></svg></button>
        <button type="button" class="nm-rv-arrow nm-rv-next" data-nm-rv-dir="1" aria-label="{{ section.settings.next_label }}"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="#000" stroke-width="2" fill="none"/></svg></button>
      </div>
    </div>
  </div>

  <div class="nm-iwt">
    <div class="nm-col nm-reveal" data-nm-reveal>
      {%- if section.settings.iwt_image != blank -%}
        <div class="nm-iwt__img">{{ section.settings.iwt_image | image_url: width: 1170 | image_tag: widths: '390,600,780,1170', sizes: '(min-width: 600px) 600px, 100vw', alt: section.settings.iwt_alt, loading: 'lazy' }}</div>
      {%- endif -%}
      <div class="nm-iwt__body">
        <h2 class="nm-iwt__h">{{ section.settings.iwt_heading }}</h2>
        <div class="nm-iwt__txt">
          {{ section.settings.iwt_text }}
          {%- for block in section.blocks -%}
            {%- if block.type == 'bullet' -%}<div {{ block.shopify_attributes }}>{{ block.settings.text }}</div>{%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>

  <div class="nm-pct">
    <div class="nm-col">
      <div class="nm-pct__num"><span data-nm-counter data-to="{{ section.settings.pct_value }}" data-duration="2000">{{ section.settings.pct_value }}</span><span>{{ section.settings.pct_symbol }}</span></div>
      <p class="nm-pct__txt">{{ section.settings.pct_text }}</p>
    </div>
  </div>
</div>

<script>
(function(){
  var root=document.getElementById('shopify-section-{{ section.id }}');
  if(!root)return;
  var reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var slider=root.querySelector('[data-nm-slider]'),dots=root.querySelectorAll('[data-nm-dot]');
  if(slider){
    slider.addEventListener('scroll',function(){
      var i=Math.round(slider.scrollLeft/slider.clientWidth);
      dots.forEach(function(d,k){d.classList.toggle('is-active',k===i);});
    },{passive:true});
    dots.forEach(function(d){d.addEventListener('click',function(){
      slider.scrollTo({left:slider.clientWidth*+d.dataset.nmDot,behavior:reduce?'auto':'smooth'});
    });});
  }
  var qty=root.querySelector('[data-nm-qty]'),bundles=root.querySelectorAll('[data-nm-bundle]'),gifts=root.querySelectorAll('[data-nm-gift]');
  function update(q,anim){
    if(qty)qty.value=q;
    gifts.forEach(function(g){
      var was=g.classList.contains('is-locked');
      var lock=g.dataset.locked==='true'&&q<+g.dataset.unlock;
      g.classList.toggle('is-locked',lock);
      if(anim&&was&&!lock&&!reduce){g.classList.remove('is-unlocking');void g.offsetWidth;g.classList.add('is-unlocking');}
    });
  }
  bundles.forEach(function(b){
    b.querySelector('input').addEventListener('change',function(){
      bundles.forEach(function(x){x.classList.toggle('is-selected',x===b);});
      update(+b.dataset.qty,true);
    });
  });
  var track=root.querySelector('[data-nm-rv]');
  root.querySelectorAll('[data-nm-rv-dir]').forEach(function(btn){btn.addEventListener('click',function(){
    if(track)track.scrollBy({left:track.clientWidth*+btn.dataset.nmRvDir,behavior:reduce?'auto':'smooth'});
  });});
  function count(el){
    var to=parseFloat(el.dataset.to)||0,dur=+el.dataset.duration||2000,t0=null;
    if(reduce){el.textContent=to;return;}
    function step(t){if(!t0)t0=t;var p=Math.min((t-t0)/dur,1),e=p*(2-p);el.textContent=Math.round(to*e);if(p<1)requestAnimationFrame(step);}
    el.textContent='0';requestAnimationFrame(step);
  }
  var reveals=root.querySelectorAll('[data-nm-reveal]'),counters=root.querySelectorAll('[data-nm-counter]');
  if(!('IntersectionObserver' in window)){reveals.forEach(function(r){r.classList.add('is-in');});return;}
  var io=new IntersectionObserver(function(es){es.forEach(function(e){
    if(!e.isIntersecting)return;
    if(e.target.hasAttribute('data-nm-counter'))count(e.target);else e.target.classList.add('is-in');
    io.unobserve(e.target);
  });},{threshold:.15});
  reveals.forEach(function(r){io.observe(r);});
  counters.forEach(function(c){if(!reduce)c.textContent='0';io.observe(c);});
})();
</script>

